{
	"name": "obsidian-calendaric",
	"version": "0.1.0",
	"description": "Unified calendar and periodic notes for Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check:ac": "python3 docs/backlog/check_ac_coverage.py --self-check && python3 docs/backlog/check_ac_coverage.py",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"verify": "node scripts/verify.mjs",
		"release-check": "node scripts/release-check.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"prepare": "npm run build"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^22.19.15",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"happy-dom": "^20.14.3",
		"jiti": "2.6.1",
		"moment": "^2.30.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
