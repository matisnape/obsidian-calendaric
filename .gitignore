# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Python
__pycache__/

# Generated from live GitHub state (docs/backlog/build_pr_index.py); goes
# stale the moment any branch merges a new PR, unlike backlog.json which
# only reflects this branch's own epic edits. Regenerate with:
#   python3 docs/backlog/build_pr_index.py
docs/backlog/pull_requests.json
